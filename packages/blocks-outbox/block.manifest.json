  "limits": {"payloadBytes": 16384, "httpBodyBytes": 49152, "ackBytes": 16384, "destinationCount": 100, "apiCredentialCount": 256, "httpAttemptCapacityPerTenant": 100, "mutationReadLimit": 100},
