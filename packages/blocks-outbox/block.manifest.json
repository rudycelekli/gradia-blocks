  "capabilities": ["durable-queue", "actor-scoped-idempotent-enqueue", "tenant-and-role-isolation", "exclusive-send-claim", "host-pinned-destinations", "hmac-signed-delivery-and-acknowledgment", "explicit-receipt-reconciliation", "conditional-principal-config-edition-fences", "durable-mutation-metadata", "bounded-http-attempt-telemetry"],
